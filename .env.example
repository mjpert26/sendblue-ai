# =============================================================================
# Big Think Capital — Emma AI Funding Agent — Environment Template
# Copy to .env for local scripts. NEVER commit .env.
# In production, store these as n8n credentials / environment variables.
# =============================================================================

# ---------------------------------------------------------------------------
# Assistant identity (configurable — "Emma" is the default)
# ---------------------------------------------------------------------------
ASSISTANT_NAME=Emma
COMPANY_NAME="Big Think Capital"

# ---------------------------------------------------------------------------
# Safety gates (defaults are the SAFE values)
# ---------------------------------------------------------------------------
# When TEST_MODE=true every Sendblue send is mocked or redirected to the
# approved test allowlist (config table: test_allowlist_numbers).
TEST_MODE=true
# Real sends require BOTH TEST_MODE=false AND ALLOW_REAL_SEND=true.
ALLOW_REAL_SEND=false
# n8n deploy script writes to a live instance only when ALL THREE of
# N8N_API_URL, N8N_API_KEY and ALLOW_N8N_WRITE=true are set.
ALLOW_N8N_WRITE=false

# ---------------------------------------------------------------------------
# Sendblue (https://docs.sendblue.com/ — auth headers sb-api-key-id / sb-api-secret-key)
# ---------------------------------------------------------------------------
SENDBLUE_API_KEY_ID=__REPLACE_ME__
SENDBLUE_API_SECRET_KEY=__REPLACE_ME__
SENDBLUE_API_BASE_URL=https://api.sendblue.com
# Dedicated line Emma sends from (E.164)
SENDBLUE_FROM_NUMBER=+15550000000
# Emma bot seat id (see docs/SENDBLUE-SETUP.md). Optional until seat exists.
SENDBLUE_EMMA_SEAT_ID=
# Shared secret Sendblue includes in webhook request headers.
SENDBLUE_WEBHOOK_SECRET=__REPLACE_ME__
# Header name carrying the secret. Verify against current Sendblue docs;
# recorded in ASSUMPTIONS.md (A-03).
SENDBLUE_WEBHOOK_SECRET_HEADER=sb-signing-secret

# ---------------------------------------------------------------------------
# Salesforce (connected app, OAuth 2.0 — see docs/SALESFORCE-SETUP.md)
# ---------------------------------------------------------------------------
SF_INSTANCE_URL=https://yourInstance.my.salesforce.com
SF_API_VERSION=v61.0
SF_CLIENT_ID=__REPLACE_ME__
SF_CLIENT_SECRET=__REPLACE_ME__
# For the discovery scripts only; n8n uses its own Salesforce credential.
SF_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Anthropic
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=__REPLACE_ME__
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=1024

# ---------------------------------------------------------------------------
# n8n (deploy/inspection scripts only)
# ---------------------------------------------------------------------------
N8N_API_URL=
N8N_API_KEY=
# Base URL where the n8n webhooks are exposed (for webhook registration docs)
N8N_WEBHOOK_BASE_URL=https://n8n.example.com

# ---------------------------------------------------------------------------
# Slack
# ---------------------------------------------------------------------------
SLACK_HANDOFF_CHANNEL_ID=__REPLACE_ME__
SLACK_ALERTS_CHANNEL_ID=__REPLACE_ME__

# ---------------------------------------------------------------------------
# Business rules
# ---------------------------------------------------------------------------
# Messaging window in the customer's assumed timezone (24h clock)
MESSAGING_HOURS_START=09:00
MESSAGING_HOURS_END=20:00
MESSAGING_TIMEZONE=America/New_York
# Max automated follow-up attempts per lead
FOLLOWUP_MAX_ATTEMPTS=3
# Secure application link base (the link itself must be approved content)
APPLICATION_LINK_BASE_URL=https://apply.bigthinkcapital.example/start
