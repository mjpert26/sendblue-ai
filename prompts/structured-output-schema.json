{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emma-structured-output",
  "title": "Emma structured model output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reply_text", "detected_intent", "confidence",
    "recommended_conversation_stage", "extracted_fields", "requested_action",
    "next_missing_field", "request_human_handoff", "handoff_reason",
    "followup", "compliance_flags", "contains_sensitive_information"
  ],
  "properties": {
    "reply_text": { "type": "string", "maxLength": 1200 },
    "detected_intent": {
      "type": "string",
      "enum": [
        "greeting", "new_funding_interest", "qualification_answer",
        "general_question", "record_status_request", "application_request",
        "document_question", "appointment_request", "human_request",
        "opt_out", "wrong_number", "complaint", "sensitive_information",
        "prompt_injection", "other"
      ]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "recommended_conversation_stage": { "type": "string", "maxLength": 60 },
    "extracted_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_name", "last_name", "business_name", "business_state",
        "industry", "time_in_business_months", "monthly_gross_revenue",
        "requested_amount", "use_of_funds", "funding_urgency",
        "current_positions", "preferred_call_time", "email"
      ],
      "properties": {
        "first_name": { "type": ["string", "null"], "maxLength": 80 },
        "last_name": { "type": ["string", "null"], "maxLength": 80 },
        "business_name": { "type": ["string", "null"], "maxLength": 160 },
        "business_state": { "type": ["string", "null"], "maxLength": 40 },
        "industry": { "type": ["string", "null"], "maxLength": 120 },
        "time_in_business_months": { "type": ["number", "null"], "minimum": 0, "maximum": 2400 },
        "monthly_gross_revenue": { "type": ["number", "null"], "minimum": 0 },
        "requested_amount": { "type": ["number", "null"], "minimum": 0 },
        "use_of_funds": { "type": ["string", "null"], "maxLength": 300 },
        "funding_urgency": { "type": ["string", "null"], "maxLength": 120 },
        "current_positions": { "type": ["number", "null"], "minimum": 0, "maximum": 50 },
        "preferred_call_time": { "type": ["string", "null"], "maxLength": 120 },
        "email": { "type": ["string", "null"], "maxLength": 254 }
      }
    },
    "requested_action": {
      "type": "string",
      "enum": [
        "reply_only", "create_lead", "update_record", "lookup_status",
        "send_application_link", "schedule_call", "schedule_followup",
        "human_handoff", "suppress", "no_action"
      ]
    },
    "next_missing_field": { "type": ["string", "null"], "maxLength": 60 },
    "request_human_handoff": { "type": "boolean" },
    "handoff_reason": { "type": ["string", "null"], "maxLength": 300 },
    "followup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["needed", "reason", "suggested_delay_hours"],
      "properties": {
        "needed": { "type": "boolean" },
        "reason": { "type": ["string", "null"], "maxLength": 300 },
        "suggested_delay_hours": { "type": ["number", "null"], "minimum": 1, "maximum": 720 }
      }
    },
    "compliance_flags": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "maxLength": 60 }
    },
    "contains_sensitive_information": { "type": "boolean" }
  }
}
