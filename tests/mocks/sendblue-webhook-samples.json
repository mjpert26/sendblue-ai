  },
  "outbound_event_on_inbound_endpoint": {
    "$comment": "is_outbound=true arriving at the receive endpoint — must be ignored.",
    "headers": { "sb-signing-secret": "__USE_YOUR_CONFIGURED_SECRET__" },
    "body": { "content": "our own send echo", "is_outbound": true, "message_handle": "mock-handle-0005", "from_number": "+15550100009", "to_number": "+15550100001" }
