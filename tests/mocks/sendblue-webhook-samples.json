{
  "$comment": "Mock Sendblue webhook payloads for manual UAT against SB-01/SB-07 (fictional +1555 numbers, fake handles). POST these to the n8n webhook endpoints with the configured secret header. Field set mirrors the documented receive-webhook payload; unknown org-specific fields pass through untouched.",
  "inbound_message": {
    "headers": { "sb-signing-secret": "__USE_YOUR_CONFIGURED_SECRET__" },
    "body": {
