      "content": "Hi, I need funding for my restaurant",
      "media_url": "",
      "is_outbound": false,
      "status": "RECEIVED",
      "error_code": null,
      "error_message": null,
      "message_handle": "mock-handle-0001",
      "date_sent": "2026-07-10T15:00:00.000Z",
