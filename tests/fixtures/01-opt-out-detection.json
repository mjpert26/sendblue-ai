    { "id": "optout-fp-dont-stop", "kind": "opt_out", "description": "FALSE POSITIVE guard: 'please don't stop'", "input": { "message": "please don't stop" }, "expected": { "optOut": false } },
    { "id": "optout-fp-dont-cancel", "kind": "opt_out", "description": "FALSE POSITIVE guard: don't cancel my application", "input": { "message": "please don't cancel my application" }, "expected": { "optOut": false } },
    { "id": "optout-fp-stop-mid-sentence", "kind": "opt_out", "description": "'stop' embedded mid-sentence does not opt out", "input": { "message": "I can't stop thinking about the loan offer" }, "expected": { "optOut": false } },
    { "id": "optout-fp-normal-question", "kind": "opt_out", "description": "ordinary funding question is not an opt-out", "input": { "message": "What do I need to apply for funding?" }, "expected": { "optOut": false } }
