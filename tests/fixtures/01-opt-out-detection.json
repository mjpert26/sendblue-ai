    { "id": "optout-unsubscribe", "kind": "opt_out", "description": "unsubscribe opts out", "input": { "message": "unsubscribe" }, "expected": { "optOut": true } },
    { "id": "optout-cancel", "kind": "opt_out", "description": "cancel alone opts out", "input": { "message": "cancel" }, "expected": { "optOut": true } },
    { "id": "optout-remove-me", "kind": "opt_out", "description": "remove me opts out", "input": { "message": "Remove me" }, "expected": { "optOut": true } },
    { "id": "optout-stop-texting", "kind": "opt_out", "description": "stop texting mid-message opts out", "input": { "message": "Please stop texting me" }, "expected": { "optOut": true } },
    { "id": "optout-take-me-off", "kind": "opt_out", "description": "take me off your list opts out", "input": { "message": "take me off your list please" }, "expected": { "optOut": true } },
    { "id": "optout-never-signed-up", "kind": "opt_out", "description": "I never signed up opts out", "input": { "message": "I never signed up" }, "expected": { "optOut": true } },
    { "id": "optout-natural-language", "kind": "opt_out", "description": "natural-language opt-out", "input": { "message": "quit texting me man" }, "expected": { "optOut": true } },
