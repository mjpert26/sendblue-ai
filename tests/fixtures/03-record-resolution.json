{
  "$comment": "SB-03 deterministic resolution: never guess between records; converted leads resolve to contacts; per-record controls respected; application selection deterministic.",
  "cases": [
    { "id": "resolve-unknown-lead", "kind": "resolve", "description": "unknown inbound number -> no_match (Journey A entry)", "input": { "matches": [] }, "expected": { "outcome": "no_match" } },
    { "id": "resolve-existing-lead", "kind": "resolve", "description": "single Lead match", "input": { "matches": [{ "object": "Lead", "id": "00Q_TEST1", "fields": {} }] }, "expected": { "outcome": "single_match" } },
    { "id": "resolve-existing-contact", "kind": "resolve", "description": "single Contact match", "input": { "matches": [{ "object": "Contact", "id": "003_TEST1", "fields": {} }] }, "expected": { "outcome": "single_match" } },
    { "id": "resolve-converted-lead", "kind": "resolve", "description": "converted Lead resolves to its Contact", "input": { "matches": [{ "object": "Lead", "id": "00Q_TEST2", "isConverted": true, "convertedContactId": "003_TEST9", "fields": {} }] }, "expected": { "outcome": "single_match" } },
    { "id": "resolve-converted-plus-contact-same", "kind": "resolve", "description": "converted Lead + its own Contact dedupe to one record", "input": { "matches": [{ "object": "Lead", "id": "00Q_TEST2", "isConverted": true, "convertedContactId": "003_TEST9", "fields": {} }, { "object": "Contact", "id": "003_TEST9", "fields": {} }] }, "expected": { "outcome": "single_match" } },
    { "id": "resolve-multiple-leads", "kind": "resolve", "description": "two different Leads -> multiple_match, never guess", "input": { "matches": [{ "object": "Lead", "id": "00Q_A", "fields": {} }, { "object": "Lead", "id": "00Q_B", "fields": {} }] }, "expected": { "outcome": "multiple_match" } },
    { "id": "resolve-opted-out", "kind": "resolve", "description": "record found but opted out", "input": { "matches": [{ "object": "Lead", "id": "00Q_C", "fields": { "sms_opt_out": "true" } }] }, "expected": { "outcome": "opted_out" } },
    { "id": "resolve-wrong-number-flag", "kind": "resolve", "description": "record found but marked wrong number", "input": { "matches": [{ "object": "Lead", "id": "00Q_D", "fields": { "wrong_number": "true" } }] }, "expected": { "outcome": "wrong_number" } },
    { "id": "resolve-human-takeover", "kind": "resolve", "description": "record found but human takeover active", "input": { "matches": [{ "object": "Lead", "id": "00Q_E", "fields": { "human_takeover": "true" } }] }, "expected": { "outcome": "human_takeover" } },
    { "id": "resolve-ai-disabled", "kind": "resolve", "description": "record found but AI disabled on record", "input": { "matches": [{ "object": "Lead", "id": "00Q_F", "fields": { "ai_enabled": "false" } }] }, "expected": { "outcome": "ai_disabled" } },
    { "id": "resolve-optout-beats-takeover", "kind": "resolve", "description": "opt-out outranks human takeover in outcome precedence", "input": { "matches": [{ "object": "Lead", "id": "00Q_G", "fields": { "sms_opt_out": "true", "human_takeover": "true" } }] }, "expected": { "outcome": "opted_out" } },
    { "id": "app-select-single", "kind": "application_select", "description": "one open Opportunity is selected", "input": { "apps": [{ "id": "006_1", "closed": false }] }, "expected": { "outcome": "selected" } },
    { "id": "app-select-linked-preferred", "kind": "application_select", "description": "explicitly linked application preferred over others", "input": { "apps": [{ "id": "006_1", "closed": false }, { "id": "006_2", "closed": false, "explicitly_linked": true }] }, "expected": { "outcome": "selected", "application": { "id": "006_2" } } },
    { "id": "app-select-multiple-ambiguous", "kind": "application_select", "description": "multiple active applications -> ambiguous, never guess", "input": { "apps": [{ "id": "006_1", "closed": false }, { "id": "006_2", "closed": false }] }, "expected": { "outcome": "ambiguous" } },
    { "id": "app-select-closed-excluded", "kind": "application_select", "description": "closed records excluded by default", "input": { "apps": [{ "id": "006_1", "closed": true }] }, "expected": { "outcome": "none" } },
    { "id": "verify-level1-confirmed", "kind": "verification", "description": "phone match + business-name confirmation -> level 1", "input": { "resolution": { "outcome": "single_match", "record": { "fields": { "business_name": "Blue Sky Bakery" } } }, "confirmation": { "factor": "business_name", "value": "blue sky bakery" } }, "expected": { "level": 1 } },
    { "id": "verify-conflict-stays-0", "kind": "verification", "description": "conflicting confirmation stays level 0", "input": { "resolution": { "outcome": "single_match", "record": { "fields": { "business_name": "Blue Sky Bakery" } } }, "confirmation": { "factor": "business_name", "value": "Red Iron Gym" } }, "expected": { "level": 0 } },
    { "id": "verify-multiple-match-0", "kind": "verification", "description": "multiple match can never verify", "input": { "resolution": { "outcome": "multiple_match" }, "confirmation": { "factor": "first_name", "value": "Sam" } }, "expected": { "level": 0 } },
    { "id": "verify-level2-provider", "kind": "verification", "description": "level-2 provider success -> level 2", "input": { "resolution": { "outcome": "single_match", "record": { "fields": {} } }, "confirmation": null, "level2Result": true }, "expected": { "level": 2 } },
    { "id": "phone-normalize-us10", "kind": "phone", "description": "US 10-digit normalizes to E.164", "input": { "raw": "(555) 010-0001" }, "expected": { "normalized": "+15550100001" } },
    { "id": "phone-normalize-garbage", "kind": "phone", "description": "unparseable input returns null", "input": { "raw": "hello" }, "expected": { "normalized": null } },
    { "id": "cross-customer-access", "kind": "action_permission", "description": "attempt to access another record: lookup_status not permitted on multiple_match", "input": { "action": "lookup_status", "outcome": "multiple_match" }, "expected": { "permitted": false } }
  ]
}
