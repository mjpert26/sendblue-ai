{
  "$comment": "Follow-up rechecks, customer-safe stage mapping, error categorization, messaging hours.",
  "cases": [
    { "id": "followup-eligible", "kind": "followup", "description": "clean context is eligible", "input": { "ctx": { "global_ai_enabled": true, "followups_enabled": true, "opted_out": false, "wrong_number": false, "human_takeover": false, "record_ai_enabled": true, "consent_ok": true, "attempt": 1, "max_attempts": 3, "stage_eligible": true, "inbound_since_scheduled": false, "appointment_pending": false, "within_messaging_hours": true } }, "expected": { "eligible": true } },
    { "id": "followup-max-attempts", "kind": "followup", "description": "max attempts enforced (no endless nurture loops)", "input": { "ctx": { "global_ai_enabled": true, "followups_enabled": true, "opted_out": false, "wrong_number": false, "human_takeover": false, "record_ai_enabled": true, "consent_ok": true, "attempt": 4, "max_attempts": 3, "stage_eligible": true, "inbound_since_scheduled": false, "appointment_pending": false, "within_messaging_hours": true } }, "expected": { "eligible": false, "skipReasons": ["max_attempts_exceeded"] } },
    { "id": "followup-customer-replied", "kind": "followup", "description": "follow-up cancelled when customer replied since scheduling", "input": { "ctx": { "global_ai_enabled": true, "followups_enabled": true, "opted_out": false, "wrong_number": false, "human_takeover": false, "record_ai_enabled": true, "consent_ok": true, "attempt": 1, "max_attempts": 3, "stage_eligible": true, "inbound_since_scheduled": true, "appointment_pending": false, "within_messaging_hours": true } }, "expected": { "eligible": false, "skipReasons": ["customer_replied"] } },
    { "id": "followup-takeover-blocks", "kind": "followup", "description": "human takeover blocks follow-ups", "input": { "ctx": { "global_ai_enabled": true, "followups_enabled": true, "opted_out": false, "wrong_number": false, "human_takeover": true, "record_ai_enabled": true, "consent_ok": true, "attempt": 1, "max_attempts": 3, "stage_eligible": true, "inbound_since_scheduled": false, "appointment_pending": false, "within_messaging_hours": true } }, "expected": { "eligible": false, "skipReasons": ["human_takeover"] } },
    { "id": "followup-optout-blocks", "kind": "followup", "description": "opt-out blocks follow-ups", "input": { "ctx": { "global_ai_enabled": true, "followups_enabled": true, "opted_out": true, "wrong_number": false, "human_takeover": false, "record_ai_enabled": true, "consent_ok": true, "attempt": 1, "max_attempts": 3, "stage_eligible": true, "inbound_since_scheduled": false, "appointment_pending": false, "within_messaging_hours": true } }, "expected": { "eligible": false, "skipReasons": ["opted_out"] } },
    { "id": "followup-appointment-blocks", "kind": "followup", "description": "pending appointment blocks nurture follow-up", "input": { "ctx": { "global_ai_enabled": true, "followups_enabled": true, "opted_out": false, "wrong_number": false, "human_takeover": false, "record_ai_enabled": true, "consent_ok": true, "attempt": 1, "max_attempts": 3, "stage_eligible": true, "inbound_since_scheduled": false, "appointment_pending": true, "within_messaging_hours": true } }, "expected": { "eligible": false, "skipReasons": ["appointment_pending"] } },
    { "id": "followup-stage-ineligible", "kind": "followup", "description": "underwriting-type stage not eligible for automated follow-up", "input": { "ctx": { "global_ai_enabled": true, "followups_enabled": true, "opted_out": false, "wrong_number": false, "human_takeover": false, "record_ai_enabled": true, "consent_ok": true, "attempt": 1, "max_attempts": 3, "stage_eligible": false, "inbound_since_scheduled": false, "appointment_pending": false, "within_messaging_hours": true } }, "expected": { "eligible": false, "skipReasons": ["stage_not_eligible"] } },
    { "id": "stage-map-unmapped-escalates", "kind": "stage_map", "description": "unmapped internal value escalates (never guessed)", "input": { "object": "Opportunity", "field": "StageName", "value": "Some Unknown Internal Stage" }, "expected": { "mapped": false, "behavior": "escalate" } },
    { "id": "stage-map-underwriting", "kind": "stage_map", "description": "underwriting placeholder maps to UNDERWRITING with level-1 wording", "input": { "object": "Opportunity", "field": "StageName", "value": "PLACEHOLDER_Underwriting" }, "expected": { "mapped": true, "stage": { "stage": "UNDERWRITING", "verification_level": 1 } } },
    { "id": "stage-map-funded-needs-level2", "kind": "stage_map", "description": "FUNDED requires verification level 2", "input": { "object": "Opportunity", "field": "StageName", "value": "PLACEHOLDER_ClosedWon" }, "expected": { "mapped": true, "stage": { "stage": "FUNDED", "verification_level": 2 } } },
    { "id": "stage-map-funding-pending-human", "kind": "stage_map", "description": "FUNDING_PENDING requires human escalation", "input": { "object": "Opportunity", "field": "StageName", "value": "PLACEHOLDER_FundingPending" }, "expected": { "mapped": true, "stage": { "stage": "FUNDING_PENDING", "human_escalation_required": true } } },
    { "id": "stage-map-app-submitted", "kind": "stage_map", "description": "application received maps to APPLICATION_SUBMITTED", "input": { "object": "Opportunity", "field": "StageName", "value": "PLACEHOLDER_AppSubmitted" }, "expected": { "mapped": true, "stage": { "stage": "APPLICATION_SUBMITTED" } } },
    { "id": "stage-map-docs-needed", "kind": "stage_map", "description": "missing items maps to DOCUMENTS_NEEDED", "input": { "object": "Opportunity", "field": "StageName", "value": "PLACEHOLDER_DocsNeeded" }, "expected": { "mapped": true, "stage": { "stage": "DOCUMENTS_NEEDED" } } },
    { "id": "error-sendblue-401", "kind": "error_category", "description": "Sendblue 401 is non-retryable auth alert", "input": { "statusCode": 401 }, "expected": { "category": "auth", "retryable": false, "alert": true } },
    { "id": "error-sendblue-429", "kind": "error_category", "description": "Sendblue 429 is retryable with backoff", "input": { "statusCode": 429 }, "expected": { "category": "rate_limit", "retryable": true } },
    { "id": "error-sendblue-500", "kind": "error_category", "description": "Sendblue 500 retryable", "input": { "statusCode": 500 }, "expected": { "category": "upstream_5xx", "retryable": true } },
    { "id": "error-salesforce-timeout", "kind": "error_category", "description": "Salesforce timeout retryable", "input": { "statusCode": 0, "context": { "timeout": true } }, "expected": { "category": "timeout", "retryable": true } },
    { "id": "error-claude-timeout", "kind": "error_category", "description": "Claude 408 timeout retryable", "input": { "statusCode": 408 }, "expected": { "category": "timeout", "retryable": true } },
    { "id": "hours-inside", "kind": "messaging_hours", "description": "noon ET Wednesday is inside the window", "input": { "now": "2026-07-08T16:00:00.000Z", "hours": { "timezone": "America/New_York", "start": "09:00", "end": "20:00", "days": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat"] } }, "expected": { "within": true } },
    { "id": "hours-late-night", "kind": "messaging_hours", "description": "2am ET is outside the window", "input": { "now": "2026-07-08T06:00:00.000Z", "hours": { "timezone": "America/New_York", "start": "09:00", "end": "20:00", "days": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat"] } }, "expected": { "within": false } },
    { "id": "hours-sunday", "kind": "messaging_hours", "description": "Sunday excluded by day rule", "input": { "now": "2026-07-12T16:00:00.000Z", "hours": { "timezone": "America/New_York", "start": "09:00", "end": "20:00", "days": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat"] } }, "expected": { "within": false } }
  ]
}
